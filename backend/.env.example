# ── Telegram Bot ───────────────────────────────────────────────────────
PLATFORM_BOT_TOKEN=your_platform_bot_token_here

# ── Database (InsForge PostgreSQL connection string) ────────────────────
# Get this from: InsForge Dashboard → Database → Connection String
DATABASE_URL=postgresql+asyncpg://postgres:password@db.insforge.dev:5432/postgres

# ── App URLs ────────────────────────────────────────────────────────────
# InsForge Compute service URL (your backend public URL)
BASE_URL=https://your-app.insforge.app

# Frontend URL (InsForge deployments or custom domain)
MINI_APP_URL=https://your-frontend.insforge.app

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── General ─────────────────────────────────────────────────────────────
COMMISSION_PERCENT=5.0
IS_TEST=true

# ── Payment Systems (optional, add when ready) ──────────────────────────
# PAYME_ID=
# PAYME_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
# UZUM_SERVICE_ID=
# UZUM_USERNAME=
# UZUM_PASSWORD=
# PAYNET_MERCHANT_ID=
